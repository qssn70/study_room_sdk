# CI should inject fresh values instead of committing a populated copy of this file.
POSTGRES_PASSWORD=replace-with-an-ephemeral-test-password
POSTGRES_USER=study_room
POSTGRES_DB=study_room

NODE_ENV=test
STUDY_ROOM_RUNTIME_PROFILE=test
STUDY_ROOM_ADMIN_JWKS_URL=http://jwks:4000/admin/jwks.json
