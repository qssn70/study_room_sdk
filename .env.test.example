STUDY_ROOM_ADMIN_JWT_AUDIENCE=study-room-admin
STUDY_ROOM_ALLOW_INSECURE_JWKS=true
E2E_FIXTURE_CONTROL_TOKEN=replace-with-a-random-per-run-control-token
