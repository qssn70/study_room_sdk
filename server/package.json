    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.27",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
