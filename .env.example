# Required by docker-compose.yml. Use a unique local value and never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password

POSTGRES_USER=study_room
POSTGRES_DB=study_room
STUDY_ROOM_HTTP_PORT=3000
STUDY_ROOM_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
STUDY_ROOM_RUNTIME_PROFILE=production
STUDY_ROOM_ADMIN_JWKS_URL=https://identity.example/admin/jwks.json
STUDY_ROOM_ADMIN_JWT_ISSUER=https://identity.example/admin
STUDY_ROOM_ADMIN_JWT_AUDIENCE=study-room-admin
STUDY_ROOM_ALLOW_INSECURE_JWKS=false
STUDY_ROOM_IP_RATE_LIMIT=120
STUDY_ROOM_APP_RATE_LIMIT=600
STUDY_ROOM_USER_RATE_LIMIT=180
STUDY_ROOM_ADMIN_RATE_LIMIT=120

# Optional OTLP HTTP trace endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
