# Copy to .env.dev, replace both placeholder secrets, and start with:
# docker compose --env-file .env.dev --profile dev up --build
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_USER=study_room
POSTGRES_DB=study_room

NODE_ENV=development
STUDY_ROOM_HTTP_PORT=3000
STUDY_ROOM_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
STUDY_ROOM_RUNTIME_PROFILE=dev
STUDY_ROOM_ADMIN_JWKS_URL=http://jwks:4000/admin/jwks.json
STUDY_ROOM_ADMIN_JWT_ISSUER=http://jwks:4000/admin
STUDY_ROOM_ADMIN_JWT_AUDIENCE=study-room-admin
STUDY_ROOM_ALLOW_INSECURE_JWKS=true
E2E_FIXTURE_CONTROL_TOKEN=replace-with-a-random-local-control-token

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
